{
  "name": "jokkoondiral-monorepo",
  "version": "0.1.0",
  "private": true,
  "author": "dofbi & AfricTivistes",
  "description": "Infrastructure Civic Tech open source - Africa ElectionLab",
  "scripts": {
    "install:all": "pnpm install",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev:public": "pnpm --filter public dev",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "dev:webhooks": "pnpm --filter webhooks dev",
    "dev:collect": "pnpm --filter collect dev",
    "dev": "pnpm --parallel --filter \"./apps/**\" dev",
    "build": "pnpm -r --if-present build",
    "seed": "node scripts/seed.js",
    "observateurs": "pnpm --silent --filter webhooks observateurs --",
    "typecheck": "pnpm -r --if-present typecheck",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "github:labels": "bash scripts/github/labels.sh",
    "github:issues-mvp": "node scripts/github/issues-mvp.mjs",
    "test": "pnpm -r --if-present test"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "license": "AGPL-3.0-only"
}
