# =============================================================
# Dockerfile – PWA de collecte (apps/collect, outil C1)
# Le thème et l'instance sont appliqués au build :
#   docker compose build --build-arg JK_THEME=sobre collect
# =============================================================

FROM node:20-alpine AS builder
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared ./packages/shared
COPY packages/protocole ./packages/protocole
COPY apps/collect ./apps/collect

RUN pnpm install --frozen-lockfile --filter collect...

ARG JK_THEME=""
RUN JK_THEME="$JK_THEME" pnpm --filter collect build

FROM nginx:alpine AS runner
COPY --from=builder /app/apps/collect/dist /usr/share/nginx/html
# Le service worker et le manifest ne doivent jamais rester en cache navigateur :
# c'est par eux qu'arrivent les mises à jour de l'app.
RUN printf '%s\n' \
  'server {' \
  '  listen 80;' \
  '  root /usr/share/nginx/html;' \
  '  index index.html;' \
  '  add_header X-Content-Type-Options "nosniff" always;' \
  '  add_header Referrer-Policy "no-referrer" always;' \
  '  add_header Permissions-Policy "camera=(self), geolocation=(self), microphone=()" always;' \
  '  location = /sw.js { add_header Cache-Control "no-cache"; add_header X-Content-Type-Options "nosniff" always; }' \
  '  location = /manifest.webmanifest { add_header Cache-Control "no-cache"; add_header X-Content-Type-Options "nosniff" always; }' \
  '  location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; add_header X-Content-Type-Options "nosniff" always; }' \
  '  location / { try_files $uri $uri/ /index.html; }' \
  '  gzip on;' \
  '  gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;' \
  '}' > /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
