# =============================================================
# Dockerfile – Serveur Webhooks Node.js (réception multi-canal + collecte C1)
# Le serveur est compilé en un seul fichier (esbuild) : l'image finale ne contient
# ni node_modules ni sources TypeScript.
# =============================================================

FROM node:20-alpine AS builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.26.1 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared ./packages/shared
COPY packages/protocole ./packages/protocole
COPY apps/webhooks ./apps/webhooks

RUN pnpm install --frozen-lockfile --filter webhooks...
RUN pnpm --filter webhooks build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000 \
    COLLECT_INSTANCE=/app/config/instance.json \
    PROTOCOLES_DIR=/app/protocoles \
    PIECES_DIR=/data/pieces \
    DATA_DIR=/data \
    MIGRATIONS_DIR=/app/migrations

COPY --from=builder /app/apps/webhooks/dist/index.js ./index.js
COPY --from=builder /app/packages/protocole/protocoles ./protocoles
# Schéma PostgreSQL, appliqué au démarrage si MIGRER_AU_DEMARRAGE=1 (base gérée : Render, VPS…)
COPY infra/postgres/*.sql ./migrations/
# Même configuration que la PWA : le serveur valide exactement le formulaire servi aux observateurs.
COPY apps/collect/config ./config

RUN mkdir -p /data/pieces && chown -R node:node /data
USER node
VOLUME ["/data"]
EXPOSE 3000
CMD ["node", "index.js"]
