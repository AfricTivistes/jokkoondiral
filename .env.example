# =============================================================
# Variables d'environnement – Jokkoondiral / Africa ElectionLab
# =============================================================
# IMPORTANT : Ne jamais commiter le fichier .env !
# Copier ce fichier : cp .env.example .env
# Modifier TOUTES les valeurs avant de déployer en production.
# =============================================================

# ── Base de données PostgreSQL ─────────────────────────────
DB_USER=postgres
DB_PASSWORD=CHANGER_CE_MOT_DE_PASSE
DB_NAME=jokkoondiral

# ── NocoDB ────────────────────────────────────────────────
# Clé JWT pour l'authentification NocoDB (générer avec : openssl rand -hex 32)
JWT_SECRET=CHANGER_CETTE_CLE_SECRETE

# Token API NocoDB (généré depuis l'interface NocoDB après connexion)
# Nécessaire pour que le serveur webhooks puisse insérer des données
NOCODB_API_TOKEN=VOTRE_TOKEN_API_NOCODB

# ── Application ───────────────────────────────────────────
# Domaine de production (sans https://)
DOMAIN=votre-domaine.org

# URL de l'API NocoDB pour le dashboard (en développement)
VITE_API_URL=http://localhost:8080/api/v1/db/data/v1/jokkoondiral

# Token API NocoDB côté front (même valeur que NOCODB_API_TOKEN)
# Exposé au navigateur – utiliser un token en lecture seule si possible
VITE_NOCODB_API_TOKEN=VOTRE_TOKEN_API_NOCODB

# Port du serveur webhooks (développement)
PORT=3000

# ── Canaux de signalement (optionnels selon votre déploiement) ──

# Telegram Bot Token (obtenu depuis @BotFather sur Telegram)
TELEGRAM_BOT_TOKEN=VOTRE_TOKEN_TELEGRAM

# Africa's Talking (SMS Gateway)
AFRICASTALKING_USERNAME=VOTRE_USERNAME
AFRICASTALKING_API_KEY=VOTRE_CLE_API

# WhatsApp Business API (Meta)
WHATSAPP_TOKEN=VOTRE_TOKEN_WHATSAPP
WHATSAPP_VERIFY_TOKEN=UN_MOT_SECRET_POUR_LA_VERIFICATION

# ── Collecte PWA (outil C1) : identification des observateurs ──
# appareils (recommandé) : chaque téléphone est activé par un lien à usage unique, révocable.
# codes : liste de codes partagés (COLLECT_CODES), pour le développement ou une très petite équipe.
# La même valeur doit figurer dans apps/collect/config/instance.json (« identification »).
IDENTIFICATION=appareils
# Secret maître (≥ 32 caractères) : empreintes des clés et chiffrement des numéros.
# Générer : openssl rand -base64 48. En production, préférer JK_SECRET_FILE (secret Docker).
JK_SECRET=CHANGER_CE_SECRET_AVEC_openssl_rand_base64_48
# Secret partagé du webhook NocoDB « générer le lien » (en-tête X-Jk-Webhook)
JK_WEBHOOK_SECRET=CHANGER_CE_SECRET_WEBHOOK
# Adresse publique de la PWA (pour fabriquer les liens d'activation)
COLLECT_URL=https://votre-domaine.org/collect/
# Mode « codes » uniquement :
COLLECT_CODES=EQ01,EQ02,EQ03

# ── Stockage des signalements et du registre ───────────────
# nocodb (défaut) | postgres | kobo  — Kobo ne peut pas héberger le registre des observateurs.
STOCKAGE_SIGNALEMENTS=nocodb
# Copies facultatives (avec reprise automatique en cas d'échec), ex. kobo
STOCKAGE_COPIES=
# nocodb | postgres (défaut : comme STOCKAGE_SIGNALEMENTS)
REGISTRE_OBSERVATEURS=
# Toute base distante doit être jointe en HTTPS / TLS vérifié. Jamais en production :
AUTORISER_SANS_TLS=
# Secrets en fichier (secrets Docker) : ajouter _FILE au nom, ex. NOCODB_API_TOKEN_FILE=/run/secrets/nocodb

# PostgreSQL direct (STOCKAGE_SIGNALEMENTS=postgres ou REGISTRE_OBSERVATEURS=postgres)
# Rôle à droits minimaux : infra/postgres/roles/jk_collecte.sql
DATABASE_URL=
PGPASSWORD=
PG_CA_CERT_FILE=

# Thème visuel de la PWA (dossier apps/collect/config/themes/<nom>) ; vide = celui d'instance.json
JK_THEME=

# Dossiers de travail : photos reçues, file de reprise des copies
PIECES_DIR=pieces
DATA_DIR=donnees

# KoboToolbox (principal ou copie). Compte dédié limité à « ajouter des soumissions ».
# Le formulaire Kobo s'importe depuis packages/protocole/kobo/<protocole>/ (XLSForm en CSV).
KOBO_SUBMISSION_URL=
KOBO_FORM_ID=
KOBO_TOKEN=
