{
  "name": "webhooks",
  "version": "0.1.0",
  "private": true,
  "description": "Réception multi-canaux : Telegram, SMS, WhatsApp",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js --log-level=warning",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "observateurs": "tsx scripts/observateurs.ts",
    "migrer": "tsx scripts/migrer.ts"
  },
  "dependencies": {
    "@jokkoondiral/protocole": "workspace:*",
    "@jokkoondiral/shared": "workspace:*",
    "express": "^4.18.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  },
  "license": "AGPL-3.0-only"
}
